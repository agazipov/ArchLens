{
  "name": "architecture-explorer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "validate:architectures": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-architectures.ts",
    "check": "npm run validate:architectures && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.65.0",
    "next": "^16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.9",
    "@babel/preset-typescript": "^7.29.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
