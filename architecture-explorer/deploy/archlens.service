[Unit]
Description=ArchLens Next.js application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=archlens
Group=archlens
WorkingDirectory=/srv/archlens/repo/architecture-explorer
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 8791
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/archlens

[Install]
WantedBy=multi-user.target
